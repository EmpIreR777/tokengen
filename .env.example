# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tokengen
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Provider settings
PROVIDER_TIMEOUT=60
PROVIDER_ALPHA_URL=http://provider-alpha:8001
PROVIDER_BETA_URL=http://provider-beta:8002
PROVIDER_SHARED_SECRET=dev-secret-change-in-production

# Webhook base URL (for providers to callback)
WEBHOOK_BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
